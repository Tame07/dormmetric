# Set these as environment variables on your host (or export them locally).
PORT=3000
NODE_ENV=production
# Long random string used to sign login cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me
# Folder for the SQLite database and uploaded photos (mount a persistent disk here when hosting)
DATA_DIR=./data
# Adds the demo dorms, demo owner and student accounts on first run (set to false for a clean database)
SEED_DEMO_DATA=true
